PORT=5000
# Comma-separated list of allowed browser origins (no trailing slash).
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Sessions are issued by this API, not by Supabase Auth.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Optional: only needed for the "Continue with Google" button.
# Must be the same OAuth client ID the frontend uses (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Supabase is used as the database only (Project Settings → API / Database).
# Use the service role key on the server only. Never put it in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Project Settings → Database → Connection string).
# Only used by `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Apply the schema with `npm run db:migrate`, or paste supabase/schema.sql and
# each file in supabase/migrations (filename order) into the Supabase SQL Editor.

# Google Gemini — used only to understand chat intent and write replies.
# Never send this key to the frontend.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Nearby promotion defaults
DEFAULT_RADIUS_KM=10
CHAT_DEFAULT_RADIUS_KM=5
MAX_RADIUS_KM=50

# Favorite-shop email notifications. Keep disabled until SMTP is configured.
NOTIFICATIONS_ENABLED=false
EMAIL_FROM=Food Waste Solver <noreply@example.com>
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

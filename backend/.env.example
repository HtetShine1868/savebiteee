PORT=5000
CLIENT_URL=http://localhost:5173

# From Supabase: Project Settings → API
# Use the service role key on the server only. Never put it in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# After creating the project, run supabase/schema.sql, then each file in
# supabase/migrations in filename order in the Supabase SQL Editor.

# Google Gemini — used only to understand chat intent and write replies.
# Never send this key to the frontend.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Nearby promotion defaults
DEFAULT_RADIUS_KM=10
CHAT_DEFAULT_RADIUS_KM=5
MAX_RADIUS_KM=50

# Favorite-shop email notifications. Keep disabled until SMTP is configured.
NOTIFICATIONS_ENABLED=false
EMAIL_FROM=Food Waste Solver <noreply@example.com>
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

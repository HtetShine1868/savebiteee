# Leave empty in development: Vite proxies /api to http://localhost:5000 (see vite.config.js).
# Set this when the API runs somewhere else, e.g. https://api.example.com
VITE_API_URL=

# Google OAuth client ID. When set, the official Google button appears on
# sign in / sign up and posts the ID token to POST /api/auth/google.
VITE_GOOGLE_CLIENT_ID=
